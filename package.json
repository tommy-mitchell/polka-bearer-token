{
	"name": "polka-bearer-token",
	"version": "1.0.0",
	"description": "Bearer token middleware for Polka.",
	"license": "MIT",
	"repository": "tommy-mitchell/polka-bearer-token",
	"author": "Tommy Mitchell (https://tommymitchell.io)",
	"type": "module",
	"exports": {
		"types": "./dist/index.d.ts",
		"default": "./dist/index.js"
	},
	"imports": {
		"#src/*.ts": "./src/*.ts"
	},
	"sideEffects": false,
	"engines": {
		"node": "^22.22 || ^24.15 || >=26"
	},
	"scripts": {
		"prepare": "npm run build",
		"prebuild": "node -e 'fs.rmSync(`./dist`, { recursive: true, force: true })'",
		"build": "npm run build:js && npm run build:dts",
		"build:js": "tsc -p tsconfig.build.json --removeComments",
		"build:dts": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
		"lint": "dprint check && xo",
		"format": "dprint fmt && xo --fix",
		"test": "c8 ava && tsd test-d"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"bearer token",
		"bearer token middleware",
		"polka",
		"authorization bearer"
	],
	"dependencies": {
		"cookie": "^2.0.1",
		"cookie-signature": "^1.2.2"
	},
	"devDependencies": {
		"@tommy-mitchell/configs": "^0.2.1",
		"@types/cookie-signature": "^1.1.2",
		"@types/node": "^20",
		"ava": "^8.0.1",
		"c8": "^12.0.0",
		"dprint": "^0.60.1",
		"get-port": "^7.2.0",
		"ky": "^2.1.0",
		"polka": "^1.0.0-next.28",
		"test-quadruple": "^1.0.0",
		"tsd": "^0.33.0",
		"typescript": "~6.0.3",
		"xo": "^5.0.1"
	},
	"peerDependencies": {
		"polka": ">=1.0.0-next"
	},
	"ava": {
		"extensions": [
			"ts"
		]
	}
}
